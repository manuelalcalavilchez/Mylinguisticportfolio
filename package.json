{
  "name": "my-linguistic-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "migrate": "npm run migrate -w apps/api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "test": "npm run test -w apps/api",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:e2e": "playwright test",
    "seed": "npm run seed -w apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
