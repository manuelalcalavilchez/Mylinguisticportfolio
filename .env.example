# ---- Copia este archivo a .env y sustituye TODOS los valores de ejemplo ----
# Nunca subas .env a Git.

NODE_ENV=production
PORT=3000
# Puerto del host (solo 127.0.0.1) al que docker-compose publica la app
HOST_PORT=3000
# Nº de proxies inversos delante (EasyPanel/Traefik o Caddy => 1; sin proxy => 0)
TRUST_PROXY=1

# URL(s) públicas exactas desde las que se accede a la app, separadas por comas.
# La primera es la principal (enlaces de recuperación y de publicación).
# Ej.: APP_ORIGIN=https://mylinguisticportfolio.es,http://192.168.1.134:8090
APP_ORIGIN=https://portfolio.ejemplo.invalid

# PostgreSQL (en docker-compose el host es "db")
POSTGRES_USER=mlp
POSTGRES_PASSWORD=cambia-esta-contrasena-larga
POSTGRES_DB=mlp
DATABASE_URL=postgres://mlp:cambia-esta-contrasena-larga@db:5432/mlp

# Secreto para firmar/derivar tokens. Genera uno con:  openssl rand -hex 32
SESSION_SECRET=sustituye-por-64-caracteres-hex-aleatorios

# Duración de la sesión en horas
SESSION_TTL_HOURS=12

# Registro de profesores durante el piloto:
#  - vacío  => registro de profesores DESACTIVADO (solo el admin crea cuentas)
#  - valor  => los profesores necesitan este código para registrarse
TEACHER_SIGNUP_CODE=

# Carpeta de archivos privados (montada como volumen, nunca dentro de /public)
STORAGE_DIR=/data/uploads
# Tamaño máximo por archivo en MB
MAX_UPLOAD_MB=10

# Pool de conexiones a Postgres (pequeño para servidores modestos)
DB_POOL_MAX=5

# Publicación pública de portfolios. Déjalo en false hasta completar la revisión legal con el centro
# (RGPD/LOPDGDD, menores, derechos de imagen). Con false se puede revisar y aprobar, pero no publicar.
PUBLICATION_ENABLED=false
# Permitir que buscadores indexen portfolios publicados (además el profesor debe marcarlo). Recomendado: false
ALLOW_PUBLIC_INDEXING=false
